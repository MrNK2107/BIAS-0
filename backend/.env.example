# Firebase Admin SDK — individual fields (preferred)
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Optional extra fields (will be auto-derived from above if omitted)
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_CLIENT_ID=

# Firebase Storage bucket (for CSV/model file uploads)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Allow all CORS origins (set to 1 for local dev)
CORS_ALLOW_ALL=1
