# Frontend environment — Firebase Web SDK config
#
# Get these values from:
#   https://console.firebase.google.com/  ->
#   select your project ->
#   Project settings (gear icon) ->
#   General tab ->
#   "Your apps" section -> click the </> Web app ->
#   "Config" radio button -> copy the values.
#
# IMPORTANT: do NOT commit a real .env file. The .env file is gitignored.
# Copy this file to .env and fill in real values, then restart `npm run dev`.

VITE_FIREBASE_API_KEY=changeme-your-api-key
VITE_FIREBASE_AUTH_DOMAIN=changeme-your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=changeme-your-project-id
VITE_FIREBASE_STORAGE_BUCKET=changeme-your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=changeme-123456789
VITE_FIREBASE_APP_ID=changeme-1:123456789:web:abcdef

# Setup checklist (do these once per environment):
#  1. Fill the values above.
#  2. Firebase Console -> Authentication -> Sign-in method:
#       - Enable "Email/Password"
#       - Enable "Google"  (and select a support email)
#  3. Firebase Console -> Authentication -> Settings -> Authorized domains:
#       - Add "localhost" and "127.0.0.1" for local dev.
#  4. Google Cloud Console -> APIs & Services -> Credentials:
#       - Open the API key -> Application restrictions:
#           For local dev, choose "None" or add "localhost" to HTTP referrers.
#           For production, restrict to your domain.
#       - API restrictions: enable "Identity Toolkit API" (and "Token Service API").
