{
  "name": "unbiased-ai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "fixture:evidence": "esbuild scripts/make-evidence-fixture.ts --bundle --platform=node --format=esm --outfile=unit/.out/make-evidence-fixture.mjs --log-level=warning && node unit/.out/make-evidence-fixture.mjs ../backend/tests/fixtures/evidence_bundle_js.zip",
    "test:unit": "esbuild \"unit/*.test.ts\" --bundle --platform=node --format=esm --outdir=unit/.out --log-level=warning && node --test \"unit/.out/*.test.js\""
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.4",
    "axios": "^1.7.9",
    "firebase": "^12.14.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.5"
  }
}
